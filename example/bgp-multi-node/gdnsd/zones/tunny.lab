$ORIGIN tunny.lab.
$TTL 60

@ IN SOA ns1.tunny.lab. admin.tunny.lab (
    2026091302 ; Serial, increase while change the config
    60 ; Refresh
    60 ; Retry
    60 ; Expire
    60 ; Negative TTL
)

@ IN NS ns1.tunny.lab.
@ IN NS ns2.tunny.lab.

ns1 IN A 10.0.0.10
ns2 IN A 10.0.0.11

@ IN A 10.0.0.11
@ IN A 10.0.0.12
@ IN A 10.0.0.13
